{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.7.0/schema.json",
  "name": "b_disp",
  "position": {
    "x": 270,
    "y": 420,
    "z": 8,
    "height": 280,
    "width": 480,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_almacen"
                    }
                  },
                  "Property": "nombre"
                }
              },
              "queryRef": "dim_almacen.nombre",
              "nativeQueryRef": "nombre",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Medidas"
                    }
                  },
                  "Property": "Disponibilidad"
                }
              },
              "queryRef": "_Medidas.Disponibilidad",
              "nativeQueryRef": "Disponibilidad"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Disponibilidad por CEDIS'"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Gráfica de barras con la disponibilidad de cada CEDIS.'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
