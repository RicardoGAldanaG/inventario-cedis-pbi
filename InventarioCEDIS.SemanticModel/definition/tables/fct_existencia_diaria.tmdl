				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"fecha", type date}, {"almacen", type text}, {"sku", type text}, {"existencia", Int64.Type}, {"en_cero", type logical}, {"venta_perdida_est", type number}}, "en-US")
				in
